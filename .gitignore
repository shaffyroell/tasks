# Never commit credentials / real tokens
accounts.json
slack-workspaces.json
email-accounts.json
client.json
clients/*.json
*.secret
*.secret.json
*.key
.env
.env.*

# Real-token overrides (keep these OUT of git). hubspot.json/clients.json are
# committed because they hold only IDs + flags (no credentials); if you ever need
# a real HubSpot private-app token, put it in hubspot.local.json or the
# HUBSPOT_TOKEN env secret — never in the committed hubspot.json.
hubspot.local.json
